PORT=2026
DATA_DIR=/data
MYNOTES_DATA_DIR=/srv/mynotes
APP_ORIGIN=http://localhost:2026
APP_ORIGINS=http://localhost:2026,https://your-device.your-tailnet.ts.net
COOKIE_SECURE=true
ALLOW_REGISTRATION=false
ALLOWED_EMAILS=first.user@example.com,second.user@example.com
# Team role of accounts registered after the first (the first is admin): guest, viewer, or member.
SIGNUP_ROLE=guest
TOTP_POLICY=optional
# Sign-in methods: password (default), google, or both. Google needs an OAuth client (Web application)
# whose redirect URI is exactly APP_ORIGIN/api/auth/google/callback; see docs/OPERATIONS.md, Google sign-in.
AUTH_METHODS=password
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: only Google accounts on these email domains may sign in or be created (e.g. example.com).
GOOGLE_ALLOWED_DOMAINS=
TOTP_ENCRYPTION_KEY=
SESSION_DAYS=14
MAX_MARKDOWN_BYTES=2000000
# Files: largest upload (1 MiB to 2 GiB), per-user quota incl. Bin (0 = unlimited), free-disk floor.
MAX_UPLOAD_BYTES=104857600
USER_STORAGE_QUOTA_BYTES=10737418240
MIN_FREE_DISK_BYTES=1073741824
# Web Push for calendar reminders: auto (on only for an https APP_ORIGIN), true, or false.
PUSH_ENABLED=auto
# VAPID contact; defaults to APP_ORIGIN. Use an https URL or mailto: address.
PUSH_SUBJECT=
# Extra push-service hosts beyond the built-in list, comma-separated (e.g. *.push.example.com).
PUSH_ENDPOINT_HOSTS=
# Outbound email through Resend (https://resend.com). Email is off unless both are set.
# MAIL_FROM is an address or "Display Name <address@your-domain>" on a domain verified in Resend.
# Failures are logged as error name, HTTP status, and a hashed recipient only; the Resend SDK's own
# error logging (full provider bodies, which can quote addresses, outside NODE_ENV=production) is off.
RESEND_API_KEY=
MAIL_FROM=
# Links in mail use APP_ORIGIN, which must be https (or set MAIL_ALLOW_HTTP_LINKS=true for a LAN/Tailscale http origin).
MAIL_ALLOW_HTTP_LINKS=false
# Shown in each mail's header and footer (defaults to the APP_ORIGIN host); one line, at most 40 characters.
MAIL_INSTANCE_NAME=
# Messages a day for the instance (1-10000). Resend's free tier allows 100.
MAIL_DAILY_LIMIT=500
# Optional: the signing secret (whsec_...) of a Resend webhook pointed at APP_ORIGIN/api/mail/webhook,
# for bounces and spam complaints. Leave empty to keep the endpoint off (it answers 404).
RESEND_WEBHOOK_SECRET=
